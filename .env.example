# Del Cani Terezzine - environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Enquiries ────────────────────────────────────────────────────────────────
# Where the "call me back" form is delivered.
LEAD_NOTIFY_TO=hello@delcaniterezzine.org

# Public contact details rendered on the page.
NEXT_PUBLIC_KENNEL_PHONE=+38050987626
NEXT_PUBLIC_KENNEL_EMAIL=hello@delcaniterezzine.org

# ─── Mail transport ───────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to run in log-only mode: leads are still stored and the
# visitor still gets a confirmation, but no mail leaves the machine.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Del Cani Terezzine <no-reply@example.com>"

# ─── Admin panel ──────────────────────────────────────────────────────────────
# Used to sign in at /admin and upload photos and video.
# Quote any value containing # or $ — otherwise it is silently truncated.
ADMIN_PASSWORD=
# Any random string, 32+ characters. Rotating it signs everyone out.
ADMIN_SESSION_SECRET=
